# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=sua-chave-gemini
# Modelo principal (melhor qualidade) e reserva (cota grátis maior), usada automaticamente se o principal estourar a cota
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# Resend (https://resend.com/api-keys): envio do formulário de contato
RESEND_API_KEY=sua-chave-resend
# Opcional: quem recebe os contatos (padrão: e-mail de src/data/profile.ts)
# CONTACT_TO_EMAIL=
